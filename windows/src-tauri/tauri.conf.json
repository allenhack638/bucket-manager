{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bucket Manager",
  "version": "0.1.1",
  "identifier": "com.bucketmanager.windows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bucket Manager",
        "width": 1120,
        "height": 650,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "visible": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Allen Benny",
    "shortDescription": "S3-compatible object storage browser",
    "longDescription": "Browse Amazon S3 and S3-compatible object storage from Windows.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
